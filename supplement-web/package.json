{
  "name": "supplement-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-supplement \"node --test test/rules.emulator.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project demo-supplement"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.37.0"
  }
}
