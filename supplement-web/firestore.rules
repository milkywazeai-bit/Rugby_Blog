rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function adminsDoc() {
      return /databases/$(database)/documents/config/admins;
    }
    function isAdmin() {
      return signedIn() && exists(adminsDoc()) && request.auth.uid in get(adminsDoc()).data.uids;
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    function okPhoto(v) {
      return v == null || (v is string && v.size() < 400000 && v.matches('^data:image/(jpeg|png|webp);base64,.*'));
    }

    // Who may edit the shared product list. The first signed-in person to claim it
    // becomes the admin; after that only an existing admin can change the list.
    match /config/admins {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids == [request.auth.uid];
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list
        && request.auth.uid in request.resource.data.uids;
      allow delete: if false;
    }

    // Shared probiotic rotation plan: everyone signed in reads it, only admins change it.
    match /config/rotation {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.methods is list
        && request.resource.data.methods.size() > 0
        && request.resource.data.methods.size() <= 12;
    }

    // Shared catalog: everyone signed in can read, only admins can write.
    match /products/{productId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && shortString(request.resource.data.name, 120)
        && request.resource.data.name.size() > 0
        && okPhoto(request.resource.data.get('photo', null));
      allow delete: if isAdmin();
    }

    // 상황별 세트: shared bundles the admin builds; anyone signed in can read them.
    match /sets/{setId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && shortString(request.resource.data.title, 60)
        && request.resource.data.title.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20;
      allow delete: if isAdmin();
    }

    // 가족: members share one inventory and see each other's progress today.
    function familyMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }
    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && shortString(request.resource.data.name, 30)
        && request.resource.data.code is string && request.resource.data.code.size() == 6;
      allow update: if signedIn() && (
        // join with the invite code
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.get('joinCode', '') == resource.data.code
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joinCode'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.members.size() <= 12)
        // leave
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
        // rename
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && shortString(request.resource.data.name, 30))
        // change my own nickname (and nobody else's)
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && shortString(request.resource.data.names[request.auth.uid], 20))
      );
      allow delete: if false;
      match /inventory/{pid} {
        allow read, write: if familyMember(fid);
      }
      match /status/{uid} {
        allow read: if familyMember(fid);
        allow write: if familyMember(fid) && request.auth.uid == uid;
      }
    }
    // Invite code → family. Readable one code at a time, never listed.
    match /familyCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.code == code;
      allow update, delete: if false;
    }

    // Each person's own schedule, logs and rotation: only that person.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
